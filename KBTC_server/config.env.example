# KBTC 서버 봇 설정. 이 파일을 config.env 로 복사한 뒤 값을 채우세요.
#   cp config.env.example config.env && nano config.env && chmod 600 config.env

# 바이낸스 API 키 (Demo 계좌 키)
BINANCE_API_KEY=
BINANCE_API_SECRET=

# demo = 데모 계좌, live = 실계좌 (실계좌는 충분히 테스트한 뒤에만)
MODE=demo

SYMBOL=BTCUSDT
# 진입 비중(%) : 사용 가능 USDT x 비중% 를 증거금으로 사용
WEIGHT=30
# 배율 : 진입할 때마다 이 배율로 맞춘다 (명목 = 증거금 x 배율)
LEVERAGE=10

# 텔레그램 말투: 에겐 / 테토
PERSONA=에겐

# true 면 처음 시작하자마자 현재 신호대로 포지션을 맞춘다. false 면 다음 09:00 일봉 마감부터.
ENTER_NOW=false

# (선택) 텔레그램 알림. 비워두면 알림 없이 로그만 남긴다.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
